APP_NAME=ISKOLARIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pulse
# DB_USERNAME=root
# DB_PASSWORD=

DB_BACKUP_KEEP_COPIES=10

# Desktop cloud backup (S3) — use DB_BACKUP_S3_* so keys survive NativePHP packaging (do not add *_SECRET to nativephp cleanup_env_keys)
DB_BACKUP_CLOUD_ENABLED=false
DB_BACKUP_CLOUD_TIMEZONE=Asia/Manila
DB_BACKUP_CLOUD_SCHEDULE_HOUR=10
DB_BACKUP_CLOUD_SCHEDULE_MINUTE=0
DB_BACKUP_CLOUD_S3_PREFIX=payroll-backups
DB_BACKUP_CLOUD_KEEP_LOCAL_GZIP=false
DB_BACKUP_S3_KEY=
DB_BACKUP_S3_SECRET=
DB_BACKUP_S3_REGION=ap-southeast-1
DB_BACKUP_S3_BUCKET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Skolaris API (Employee Load — faculty loading template source)
# Use a global / super-admin service account so every campus is visible.
SKOLARIS_API_BASE_URL=https://api-skolaris.icct.edu.ph/api/v1
SKOLARIS_API_IDENTIFIER=
SKOLARIS_API_PASSWORD=
# Optional: seed a refresh token to skip the first /login call
SKOLARIS_API_REFRESH_TOKEN=
SKOLARIS_API_TIMEOUT=30
SKOLARIS_API_TOKEN_TTL=55

# Pulse API key for Teaching Loads pull (preferred over JWT when set).
# Use the direct backend URL — not the Skolaris frontend /pulse/api bridge.
SKOLARIS_PULSE_API_BASE_URL=https://api-skolaris.icct.edu.ph/api/v1/pulse-api/v1
SKOLARIS_PULSE_API_KEY=

# NativePHP desktop packaging
NATIVEPHP_APP_VERSION=0.1.29
NATIVEPHP_APP_ID=ph.edu.icct.iskolaris
NATIVEPHP_APP_AUTHOR="ICCT Colleges"
NATIVEPHP_APP_COPYRIGHT="Copyright © ICCT Colleges"
NATIVEPHP_APP_DESCRIPTION="ISKOLARIS school management desktop application"
NATIVEPHP_APP_WEBSITE=https://icct.edu.ph
NATIVEPHP_UPDATER_ENABLED=false
