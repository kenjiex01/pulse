APP_NAME=People360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pulse
# DB_USERNAME=root
# DB_PASSWORD=

DB_BACKUP_KEEP_COPIES=10

# Desktop cloud backup (S3) — use DB_BACKUP_S3_* so keys survive NativePHP packaging (do not add *_SECRET to nativephp cleanup_env_keys)
# Store KEY/SECRET as plaintext once, then run: php artisan secrets:encrypt-env
# Encrypted values look like enc:... and are decrypted in memory when used.
DB_BACKUP_CLOUD_ENABLED=false
DB_BACKUP_CLOUD_TIMEZONE=Asia/Manila
DB_BACKUP_CLOUD_SCHEDULE_HOUR=10
DB_BACKUP_CLOUD_SCHEDULE_MINUTE=0
# Objects: {prefix}/{YYYY}/{MM}/pulse-db-{desktop}-{timestamp}.sql.gz
DB_BACKUP_CLOUD_S3_PREFIX=payroll-backups
DB_BACKUP_CLOUD_KEEP_LOCAL_GZIP=false
DB_BACKUP_S3_KEY=
DB_BACKUP_S3_SECRET=
DB_BACKUP_S3_REGION=ap-southeast-2
DB_BACKUP_S3_BUCKET=

# Biometric collector attendance exports (same bucket/credentials; objects under biometric_logs/{YYYY}/{MM}/{collector}/)
BIOMETRIC_LOGS_S3_PREFIX=biometric_logs

# Desktop installer updates (same S3 credentials; objects under payroll_installer/)
DESKTOP_INSTALLER_UPDATE_ENABLED=true
DESKTOP_INSTALLER_S3_PREFIX=payroll_installer
DESKTOP_INSTALLER_CHECK_INTERVAL_MINUTES=0

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Skolaris API (Employee Load — faculty loading template source)
# Use a global / super-admin service account so every campus is visible.
SKOLARIS_API_BASE_URL=https://api-skolaris.icct.edu.ph/api/v1
SKOLARIS_API_IDENTIFIER=
SKOLARIS_API_PASSWORD=
# Optional: seed a refresh token to skip the first /login call
SKOLARIS_API_REFRESH_TOKEN=
SKOLARIS_API_TIMEOUT=30
SKOLARIS_API_TOKEN_TTL=55

# Pulse API key for Teaching Loads pull (preferred over JWT when set).
# Use the direct backend URL — not the Skolaris frontend /pulse/api bridge.
# Prefer encrypted at rest: php artisan secrets:encrypt-env
SKOLARIS_PULSE_API_BASE_URL=https://api-skolaris.icct.edu.ph/api/v1/pulse-api/v1
SKOLARIS_PULSE_API_KEY=

# NativePHP desktop packaging
NATIVEPHP_APP_VERSION=1.0.2

# Optional: better Word/Excel preview (charts/images) via LibreOffice → PDF
# Leave empty to auto-detect portable runtime + common install paths.
LIBREOFFICE_PATH=
LIBREOFFICE_TIMEOUT=90
LIBREOFFICE_RUNTIME_DOWNLOAD=true
LIBREOFFICE_RUNTIME_VERSION=26.2.5

# Government contribution reports (PhilHealth, Pag-IBIG, SSS)
GOVERNMENT_REPORT_COMPANY_NAME="ICCT Colleges Foundation, Inc."
GOVERNMENT_REPORT_COMPANY_ADDRESS="V.V. Soliven Avenue II, Cainta, Rizal"
PAGIBIG_REPORT_EMPLOYER_SSS=03-9096072-4

# BIR Forms 1601-C / 2316 (Reports → Posted Batch Reports)
BIR_COMPANY_TIN=
BIR_COMPANY_RDO_CODE=
BIR_COMPANY_ZIP=1900
BIR_REPORT_SIGNATORY_NAME="VERONICA C. ONG"
BIR_REPORT_SIGNATORY_TITLE="VP-Chief Finance Officer"
BIR_COMPENSATION_ATC=WI010
BIR_SMW_RATE_PER_DAY=600
BIR_SMW_RATE_PER_MONTH=15650
NATIVEPHP_APP_ID=ph.edu.icct.iskolaris
NATIVEPHP_APP_AUTHOR="ICCT Colleges"
NATIVEPHP_APP_COPYRIGHT="Copyright © ICCT Colleges"
NATIVEPHP_APP_DESCRIPTION="People360 HR, timekeeping, and payroll desktop application"
NATIVEPHP_APP_WEBSITE=https://icct.edu.ph
NATIVEPHP_UPDATER_ENABLED=true
NATIVEPHP_UPDATER_PROVIDER=github
NATIVEPHP_FORCE_UPDATE=true
GITHUB_OWNER=kenjiex01
GITHUB_REPO=pulse
GITHUB_PRIVATE=false
GITHUB_V_PREFIXED_TAG_NAME=true
GITHUB_CHANNEL=latest
GITHUB_RELEASE_TYPE=release
# Build-time only (never commit). `scripts/build-desktop.sh` uses `gh auth token` if empty.
GITHUB_TOKEN=

# Payroll Register Excel layout (Reports → Payroll Register)
PAYROLL_REGISTER_COMPANY_NAME="ICCT COLLEGES FOUNDATION, INC."
PAYROLL_REGISTER_SUBTITLE="PAYROLL REGISTER - FACULTY ONLINE CLASSES"

# macOS code signing + notarization (production installs — no Gatekeeper workaround)
# Run: ./scripts/setup-mac-notarization.sh
NATIVEPHP_NOTARIZE=false
NATIVEPHP_APPLE_ID=
NATIVEPHP_APPLE_ID_PASS=
NATIVEPHP_APPLE_TEAM_ID=
# Optional: full identity name if auto-detect fails, e.g. "Developer ID Application: ICCT Colleges (TEAMID)"
NATIVEPHP_MAC_IDENTITY=
# Optional: .p12 export instead of Keychain identity
# CSC_LINK=/path/to/DeveloperIDApplication.p12
# CSC_KEY_PASSWORD=
